# Скопіюйте в .env.changelog на сервері. Ніколи не комітьте .env.changelog.
# Читає лише служба `changelog` (docs/changelog-reports.md), контейнери студії - ні.

# Токен бота від @BotFather. Можна той самий бот, що й для алертів (TELEGRAM_BOT_TOKEN),
# але окремий зручніший: команди звітів не змішуються з тривогами.
CHANGELOG_BOT_TOKEN=

# Куди слати звіти й звідки приймати команди: -1001234567890 (група чи канал) або @channelname.
CHANGELOG_CHAT_ID=

# Необовʼязково.
CHANGELOG_TITLE=ARTLINE Rich Studio
CHANGELOG_TZ=Europe/Kyiv
CHANGELOG_HOUR=5
# CHANGELOG_SEND_EMPTY=1
