{
  "ci": {
    "collect": {
      "staticDistDir": "./build/seo-fixtures",
      "url": [
        "http://localhost/landing-published-uk.html",
        "http://localhost/landing-published-pl.html",
        "http://localhost/landing-published-en.html",
        "http://localhost/rich-wrapper-uk.html",
        "http://localhost/rich-wrapper-pl.html",
        "http://localhost/rich-wrapper-en.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", {"minScore": 0.9}],
        "categories:accessibility": ["error", {"minScore": 0.9}],
        "categories:best-practices": ["warn", {"minScore": 0.8}],
        "categories:performance": ["warn", {"minScore": 0.7}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
        "largest-contentful-paint": ["warn", {"maxNumericValue": 2500}],
        "document-title": "error",
        "meta-description": "error",
        "html-has-lang": "error",
        "hreflang": "error",
        "canonical": "error",
        "is-crawlable": "error",
        "image-alt": "error",
        "heading-order": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./build/lhci"
    }
  }
}
